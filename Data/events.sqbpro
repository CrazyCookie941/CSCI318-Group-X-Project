CREATE TABLE events (
    id             INTEGER PRIMARY KEY AUTOINCREMENT,
    title          TEXT NOT NULL,
    type           TEXT NOT NULL,
    location       TEXT NOT NULL,
    price          REAL NOT NULL,
    size           TEXT NOT NULL,
    description    TEXT,
    image_location TEXT
);

